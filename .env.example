# --- Sorgente remota (endpoint PHP su hosting/api/export.php) ---
REMOTE_API_URL=
# Deve coincidere con 'api_key' in config.php sul server
REMOTE_API_KEY=
REMOTE_API_TIMEOUT_SECONDS=15

# --- Storage locale ---
LOCAL_DB_PATH=data/local.db

# --- Sync ---
# Ogni quanti minuti sincronizzare (usato solo da `python -m backend.main run`)
SYNC_INTERVAL_MINUTES=60

# --- Ollama (in rete, su un altro PC) ---
OLLAMA_HOST=http://192.168.1.X:11434
# Ollama degli embedding, se diverso da OLLAMA_HOST (default: lo stesso). Serve
# per generare con un Ollama e calcolare gli embedding con un altro
# OLLAMA_EMBED_HOST=http://127.0.0.1:11434
# Modello di embedding, usato per calcolare similarita' semantica tra entry
OLLAMA_EMBED_MODEL=bge-m3
# Modello generativo, usato per scrivere il/i tag testuali di ogni entry
OLLAMA_TAG_MODEL=llama3.1
# Numero massimo di tag per entry (in modalita' oracolare: al massimo 2 situazioni)
MAX_TAGS_PER_ENTRY=3
# Tipo di tag: "razionale" (l'argomento del pensiero) oppure "oracolare" (il
# momento che vive chi parla, scelto tra le 64 situazioni di backend/situazioni.json).
# Per l'oracolare il modello consigliato e' qwen3.5-9b
TAG_MODE=razionale
# true per lasciar "pensare" i modelli che lo supportano (lento: di solito lasciare false)
OLLAMA_THINK=false

# --- Webserver locale (serve il frontend "Nebulosa" + /api/graph, /api/tag/<nome>) ---
FRONTEND_DIST_PATH=frontend/dist
SERVE_HOST=0.0.0.0
SERVE_PORT=8000
