[Unit]
Description=Ollama per Oracolo divinazione (qwen3.5-9b e ching, porta 11500)
After=network-online.target

[Service]
User=@UTENTE@
# Istanza separata dal servizio "ollama" di sistema (porta 11434, che resta
# a servire gli embedding): i modelli generativi stanno in @HOME@/models/ollama.
Environment=OLLAMA_HOST=127.0.0.1:11500
Environment=OLLAMA_MODELS=@HOME@/models/ollama
# Dopo 10 minuti senza richieste il modello esce dalla GPU.
Environment=OLLAMA_KEEP_ALIVE=10m
ExecStart=/usr/local/bin/ollama serve
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
